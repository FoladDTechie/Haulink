# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cardano — your preprod receiving wallet address for ADA payments
NEXT_PUBLIC_HAULINK_WALLET_ADDRESS=addr_test1_your_preprod_address_here

# Blockfrost — preprod project API key (server-side only, never expose publicly)
# Get one at: https://blockfrost.io → create project → select "Cardano preprod"
BLOCKFROST_PREPROD_API_KEY=preprod_your_blockfrost_key_here

# ADA/NGN exchange rate API (optional, can hardcode for hackathon)
ADA_NGN_RATE=570

# Admin — email address that can access /admin pages
NEXT_PUBLIC_ADMIN_EMAIL=your-email@example.com
