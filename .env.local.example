# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cardano — your receiving wallet address for ADA payments
NEXT_PUBLIC_HAULINK_WALLET_ADDRESS=addr1_your_cardano_address_here

# ADA/NGN exchange rate API (optional, can hardcode for hackathon)
ADA_NGN_RATE=570
