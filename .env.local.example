# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cardano — your mainnet receiving wallet address for ADA payments
NEXT_PUBLIC_HAULINK_WALLET_ADDRESS=addr1_your_mainnet_address_here

# Blockfrost — mainnet project API key (server-side only, never expose publicly)
# Get one at: https://blockfrost.io → create project → select "Cardano mainnet"
BLOCKFROST_MAINNET_API_KEY=mainnet_your_blockfrost_key_here

# ADA/NGN exchange rate — read client-side by the booking UI, must be NEXT_PUBLIC_
NEXT_PUBLIC_ADA_NGN_RATE=570

# Same rate, kept for any server-side usage (API routes, etc.)
ADA_NGN_RATE=570

# Admin — email address that can access /admin pages
NEXT_PUBLIC_ADMIN_EMAIL=your-email@example.com
